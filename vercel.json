{
  "rewrites": [
    {
      "source": "/harsh/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/harsh/data/(.*)",
      "destination": "/data/$1"
    },
    {
      "source": "/harsh",
      "destination": "/index.html"
    },
    {
      "source": "/harsh/(.*)",
      "destination": "/index.html"
    }
  ]
}
